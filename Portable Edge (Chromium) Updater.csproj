<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Edge_Updater</RootNamespace>
    <AssemblyName>Portable Edge (Chromium) Updater</AssemblyName>
    <ApplicationIcon>Edge Updater.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Launcher\**\*.cs;tests\**\*.cs" /><EmbeddedResource Remove="Launcher\**\*;tests\**\*" /><None Remove="Launcher\**\*;tests\**\*" />
  </ItemGroup>
</Project>
