<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Portable Edge (Chromium) Updater.csproj" />
    <Compile Include="../../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../EdgeUpdateClient.cs" Link="EdgeUpdateClient.cs" />
    <Compile Include="../../EdgeInstaller.cs" Link="EdgeInstaller.cs" />
  </ItemGroup>
</Project>
